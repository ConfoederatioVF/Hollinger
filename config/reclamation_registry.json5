{
  //Curated historical coastal land reclamation & marine-transgression registry.
  //Action semantics (relative to the 2025 AD OSM coastline anchor):
  //  - "reclaimed_from_water": Present as dry land in 2025; reverts to water (0.0) before start_year, ramps linearly start_year -> end_year.
  //  - "submerged_from_land": Water in 2025; was dry land prior to start_year, transitions to water start_year -> end_year (e.g. medieval Zuiderzee, Dollard).
  //  - "canal_excavated": Water cut in 2025; was dry land before start_year (Suez, Panama).
  //Polygons are stored in data_curated/reclamation_polygons.geojson keyed by id.
  events: [
    //--- NETHERLANDS (Vos et al. 2020 Atlas of the Holocene Netherlands; OpenHistoricalMap) ---
    {
      id: "nl_flevoland_south",
      name: "Southern Flevoland (Zuidelijk Flevoland)",
      region: "Netherlands",
      action: "reclaimed_from_water",
      start_year: 1959,
      end_year: 1968,
      source: "Rijkswaterstaat / Vos et al. (2020)",
    },
    {
      id: "nl_flevoland_east",
      name: "Eastern Flevoland (Oostelijk Flevoland)",
      region: "Netherlands",
