{
  //Dynamic natural lakes, Holocene proglacial/pluvial paleolakes & 20th-century endorheic desiccation curves.
  //Action semantics (relative to 2025 AD HydroLAKES modern lake baseline):
  //  - "historical_water_body": Water during [start_year, end_year], dry land outside (e.g. Aral Sea pre-desiccation, Mega-Lake Chad, Lake Agassiz, Lake Texcoco, Tulare Lake).
  //  - "modern_lake_formed": Water in 2025, dry land prior to start_year (e.g. Salton Sea 1905).
  //Polygons are stored in data_curated/paleolake_polygons.geojson keyed by id.
  //Time-varying fractional water extent curves allow multi-stage shrinkage/expansion (e.g. Aral Sea 1960->2025).
  lakes: [
    //--- EARLY HOLOCENE PROGLACIAL & PLUVIAL PALEOLAKES ---
    //Lake Agassiz-Ojibway is DEM-derived: see proglacial_lakes in hydro_geomorph_basins.json5
    {
      id: "paleolake_mega_chad",
      name: "Holocene Mega-Lake Chad (African Humid Period)",
      action: "historical_water_body",
      curve: [
        [-10000, 0.3],
        [-9000, 0.85],
        [-7000, 1.0],
        [-5000, 0.9],
        [-3500, 0.5],
        [-2500, 0.15],
        [-1500, 0.05],
        [1960, 0.05],
        [1975, 0.0],
      ],
      source: "Leblanc et al. (2006) Palaeogeography Palaeoclimatology Palaeoecology; Armitage et al. (2015)",
    },

    //--- HISTORIC & 20TH-CENTURY ENDORHEIC LAKES ---
    {
      id: "aral_sea_1960_extent",
      name: "Aral Sea (Pre-1960 Full Extent, Outer Eastern/Southern Basin)",
      action: "historical_water_body",
      curve: [
        [-10000, 1.0],
        [1960, 1.0],
        [1970, 0.88],
        [1980, 0.72],
        [1990, 0.48],
        [2000, 0.25],
        [2009, 0.06],
        [2014, 0.0],
        [2025, 0.0],
      ],
      source: "Micklin (2007, 2016); JRC Global Surface Water (Pekel et al., 2016)",
    },
    {
      id: "aral_sea_west_deep",
      name: "Aral Sea (Western Deep Basin & Vozrozhdeniya Margin)",
      action: "historical_water_body",
      curve: [
        [-10000, 1.0],
        [1980, 1.0],
        [1995, 0.75],
        [2005, 0.45],
        [2015, 0.2],
        [2025, 0.0],
      ],
      source: "Micklin (2016); JRC Global Surface Water",
    },
    {
      id: "lake_chad_1960",
      name: "Lake Chad (Pre-1970 Open Water Basin)",
      action: "historical_water_body",
      curve: [
        [-10000, 1.0],
        [1963, 1.0],
        [1973, 0.45],
        [1985, 0.05],
        [2025, 0.0],
      ],
      source: "Coe & Foley (2001); Pham-Duc et al. (2020)",
    },
    {
      id: "lake_urmia_pre_2000",
      name: "Lake Urmia (Pre-2000 Shoreline Margin)",
      action: "historical_water_body",
      curve: [
        [-10000, 1.0],
        [1995, 1.0],
        [2005, 0.65],
        [2014, 0.12],
        [2025, 0.1],
      ],
      source: "AghaKouchak et al. (2015); JRC GSW",
    },
    {
      id: "lake_texcoco_valley",
      name: "Lake Texcoco, Chalco & Xochimilco (Valley of Mexico Drainage)",
      action: "historical_water_body",
      curve: [
        [-10000, 1.0],
        [1607, 1.0],
        [1700, 0.72],
        [1800, 0.48],
        [1900, 0.10],
        [1940, 0.0],
      ],
      source: "Candiani (2014) Dreaming of Dry Land; CONAGUA",
    },
    {
      id: "tulare_lake_ca",
      name: "Tulare Lake (California Central Valley Drainage)",
      action: "historical_water_body",
      curve: [
        [-10000, 1.0],
        [1870, 1.0],
        [1895, 0.35],
        [1900, 0.12],
        [1920, 0.0],
      ],
      source: "USGS Historical Topographic Maps",
    },
    {
      id: "lop_nur_basin",
      name: "Lop Nur (Tarim Basin Desiccation)",
      action: "historical_water_body",
      curve: [
        [-10000, 1.0],
        [1950, 0.7],
        [1965, 0.25],
        [1972, 0.0],
      ],
      source: "Xia et al. (2007) Lop Nur Environmental Evolution",
    },
    {
      id: "salton_sea_1905",
      name: "Salton Sea (1905–1907 Colorado River Breach)",
      action: "modern_lake_formed",
      curve: [
        [-10000, 0.0],
        [1904, 0.0],
        [1905, 0.4],
        [1907, 1.0],
        [2025, 1.0],
      ],
      source: "USGS Salton Sea Hydrologic Record",
    },
  ],
}
