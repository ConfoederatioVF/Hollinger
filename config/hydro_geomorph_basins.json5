{
  //Authoritative 30-arcsecond ETOPO 2022 topographic-contour basin & Holocene delta progradation config.
  //Eliminates hand-drawn blob polygons in favour of real 900m bathymetric/topographic shorelines.

  //1. Closed / sill-controlled basins driven by exact 30" connected-component water-surface elevation z(t) (metres)
  seeded_basins: [
    {
      id: "caspian_sea",
      name: "Caspian Sea & Lower Volga (Late Khvalynian -> Mangyshlak -> New Caspian -> Modern)",
      bbox: { lat_min: 36.0, lat_max: 49.5, lon_min: 45.5, lon_max: 56.0 },
      seed: { lat: 40.0, lon: 51.0 },
      //Exclude static HydroLAKES Caspian polygon so dynamic 30" contours control all 218 timesteps
      exclude_from_static_natlakes: true,
      //Published Caspian Sea level curve in m a.s.l. (Krijgsman et al. 2019; Kuzucuoglu & Leroy 2023; Svitoch 2012)
      level_curve_m: [
        [-10000, -18.0],
        [-9500, -28.0],
        [-8800, -50.0],
        [-7500, -48.0],
        [-6500, -26.0],
        [-5500, -19.0],
        [-4000, -19.5],
        [-3000, -22.5],
        [-2000, -25.0],
        [-1000, -26.0],
        [0, -27.5],
        [500, -28.0],
        [1000, -26.5],
        [1500, -25.5],
        [1850, -26.0],
        [1930, -26.2],
        [1977, -29.0],
        [1995, -26.6],
        [2025, -28.5],
      ],
    },
    {
      id: "black_sea_neoeuxinian",
      name: "Black Sea & Sea of Azov (Neoeuxinian Isolated Lake -> Bosporus Reconnection)",
      bbox: { lat_min: 40.5, lat_max: 47.8, lon_min: 27.0, lon_max: 42.0 },
      seed: { lat: 43.0, lon: 34.0 },
      exclude_from_static_natlakes: false,
      //Only overrides GIA ocean during isolated Neoeuxinian phase (year <= active_max_year)
      active_max_year: -5000,
      is_marine_override: true,
      //Yanko-Hombach et al. (2007); Soulet et al. (2011)
      level_curve_m: [
        [-10000, -46.0],
        [-8500, -40.0],
        [-7400, -32.0],
        [-6500, -15.0],
        [-5500, -3.0],
        [-5000, 0.0],
      ],
    },
    {
      id: "aral_sea_unified_south",
      name: "Aral Sea (1960 Full Extent -> Large Southern Aral Desiccation)",
      bbox: { lat_min: 43.0, lat_max: 47.0, lon_min: 58.0, lon_max: 62.2 },
      seed: { lat: 45.0, lon: 58.8 },
      exclude_from_static_natlakes: true,
      //Micklin (2007, 2016) Kronstadt gauge elevation curve (m a.s.l.)
      level_curve_m: [
        [-10000, 53.4],
        [1960, 53.4],
        [1965, 52.5],
        [1970, 51.3],
        [1975, 49.0],
        [1980, 46.0],
        [1985, 42.0],
        [1989, 39.0],
        [1990, 38.5],
        [1995, 36.0],
        [2000, 33.5],
        [2005, 31.0],
        [2010, 29.2],
        [2015, 28.5],
        [2025, 28.2],
      ],
    },
    {
      id: "aral_sea_north_small",
      name: "Small (Northern) Aral Sea (Post-1989 Split & 2005 Kokaral Dam Stabilisation)",
      bbox: { lat_min: 45.8, lat_max: 47.0, lon_min: 59.5, lon_max: 62.0 },
      seed: { lat: 46.45, lon: 60.9 },
      exclude_from_static_natlakes: true,
      active_min_year: 1989,
      level_curve_m: [
        [1989, 39.5],
        [1995, 40.5],
        [2000, 39.8],
        [2005, 41.2],
        [2006, 42.0],
        [2025, 42.0],
      ],
    },
    {
      id: "lake_chad_mega_chad",
      name: "Lake Chad & Holocene Mega-Lake Chad (African Humid Period -> 1960 -> Modern Desiccation)",
      bbox: { lat_min: 10.5, lat_max: 19.5, lon_min: 11.5, lon_max: 20.5 },
      seed: { lat: 13.3, lon: 14.0 },
      exclude_from_static_natlakes: true,
      //Armitage et al. (2015); Leblanc et al. (2006); Coe & Foley (2001).
      //Naturally spills across the ~286m Bahr el Ghazal sill into Bodele during 9500-3500 BC!
      level_curve_m: [
        [-10000, 292.0],
        [-9000, 318.0],
        [-7500, 326.0],
        [-5500, 325.0],
        [-4000, 315.0],
        [-3200, 288.0],
        [-2500, 283.0],
        [0, 282.5],
        [1963, 282.5],
        [1973, 280.0],
        [1985, 279.0],
        [2025, 279.0],
      ],
    },
    {
      id: "lake_urmia",
      name: "Lake Urmia (Pre-2000 Full Extent -> Desiccation)",
      bbox: { lat_min: 36.8, lat_max: 38.4, lon_min: 44.8, lon_max: 46.1 },
      seed: { lat: 37.7, lon: 45.4 },
      exclude_from_static_natlakes: true,
      level_curve_m: [
        [-10000, 1277.5],
        [1995, 1277.5],
        [2005, 1274.0],
        [2014, 1270.5],
        [2025, 1271.0],
      ],
    },
  ],

  //2. Holocene prograding alluvial deltas driven by 30" ocean-connected sediment back-stripping (active >= -5500, zero ghost fade)
  delta_progradation_basins: [
    {
      id: "mesopotamia_persian_gulf",
      name: "Ancient Mesopotamia / Tigris-Euphrates-Karun Delta & Persian Gulf Head",
      bbox: { lat_min: 29.2, lat_max: 32.8, lon_min: 45.0, lon_max: 50.0 },
      sea_seed: { lat: 29.55, lon: 49.1 },
      min_year: -5500,
      clean_stipples: true,
      source: "Lambeck (1996); Heyvaert & Baeteman (2007); Pournelle (2003)",
      //At 5500-4000 BC: backstrip ~9.5-10.0m floods Gulf head to Ur, Eridu, Lagash & Amarah; Basra underwater!
      backstrip_curve_m: [
        [-5500, 6.0],
        [-4500, 10.0],
        [-3800, 9.2],
        [-3000, 7.5],
        [-2000, 5.8],
        [-1000, 4.2],
        [0, 3.0],
        [1000, 1.8],
        [1700, 0.8],
        [1950, 0.2],
        [2025, 0.0],
      ],
    },
    {
      id: "nile_delta",
      name: "Nile Delta Holocene Progradation",
      bbox: { lat_min: 30.4, lat_max: 31.8, lon_min: 29.5, lon_max: 32.8 },
      sea_seed: { lat: 31.65, lon: 31.2 },
      min_year: -5500,
      clean_stipples: true,
      source: "Stanley & Warne (1994)",
      backstrip_curve_m: [
        [-5500, 2.0],
        [-4500, 2.8],
        [-2000, 1.8],
        [0, 1.0],
        [1500, 0.4],
        [1950, 0.1],
        [2025, 0.0],
      ],
    },
    {
      id: "po_delta_venice",
      name: "Po River Delta & Venetian Lagoon Holocene Progradation",
      bbox: { lat_min: 44.1, lat_max: 46.0, lon_min: 11.4, lon_max: 13.8 },
      sea_seed: { lat: 45.0, lon: 13.0 },
      min_year: -5500,
      clean_stipples: true,
      source: "Amorosi et al. (2017)",
      backstrip_curve_m: [
        [-5500, 2.2],
        [-4500, 3.2],
        [0, 1.8],
        [1500, 0.8],
        [1900, 0.25],
        [2025, 0.0],
      ],
    },
  ],

  //2b. Smooth 30" SDF-migrating paleoshoreline deltas (China Bohai/Jiangsu/Yangtze/PRD matching Herrmann 1 AD,
  //    plus Great Rann of Kutch, Chao Phraya/Bangkok Sea, Mekong, Ganges-Brahmaputra, Mississippi Birdfoot).
  //    ZERO Swiss-cheese interior depression flooding, ZERO ghost alpha-fade, bedrock hills preserved via 30" DEM!
  sdf_delta_progradation_basins: [
    {
      id: "china_bohai_yellow_river",
      name: "Bohai Bay, Tianjin & Yellow River Delta (Herrmann 1 AD / Tan Qixiang)",
      bbox: { lat_min: 36.8, lat_max: 40.0, lon_min: 116.5, lon_max: 120.5 },
      max_alluvial_elev_m: 15.0,
      min_year: -5500,
      max_year: 2024,
      modern_anchor_year: 2025,
      preserve_hills: true,
    },
    {
      id: "china_jiangsu_yangtze_shanghai",
      name: "Jiangsu Coast, Yangtze Funnel Estuary & Hangzhou Bay (Herrmann 1 AD / Tan Qixiang)",
      bbox: { lat_min: 29.9, lat_max: 35.3, lon_min: 118.9, lon_max: 122.6 },
      max_alluvial_elev_m: 15.0,
      min_year: -5500,
      max_year: 2024,
      modern_anchor_year: 2025,
      preserve_hills: true,
    },
    {
      id: "china_pearl_river_delta",
      name: "Pearl River Delta Holocene Progradation (Zong et al. 2009)",
      bbox: { lat_min: 21.8, lat_max: 23.3, lon_min: 112.8, lon_max: 114.5 },
      max_alluvial_elev_m: 14.0,
      min_year: -5500,
      max_year: 2024,
      modern_anchor_year: 2025,
      preserve_hills: true,
    },
    {
      id: "in_rann_of_kutch",
      name: "Great & Little Rann of Kutch (Open Marine Gulf in 4000 BC & 1 AD -> Kutch Island)",
      bbox: { lat_min: 22.4, lat_max: 24.9, lon_min: 67.7, lon_max: 72.0 },
      max_alluvial_elev_m: 6.0,
      min_year: -5500,
      max_year: 1499,
      modern_anchor_year: 1500,
      preserve_hills: true,
    },
    {
      id: "th_chao_phraya_bangkok_sea",
      name: "Chao Phraya Delta / Bangkok Sea Embayment (Sinsakul 2000; Tanabe et al. 2003)",
      bbox: { lat_min: 12.9, lat_max: 14.9, lon_min: 99.7, lon_max: 101.4 },
      max_alluvial_elev_m: 10.0,
      min_year: -5500,
      max_year: 2024,
      modern_anchor_year: 2025,
      preserve_hills: true,
    },
    {
      id: "vn_mekong_delta",
      name: "Mekong Delta Holocene Progradation (Nguyen et al. 2000; Tamura et al. 2009)",
      bbox: { lat_min: 8.1, lat_max: 11.1, lon_min: 104.1, lon_max: 107.4 },
      max_alluvial_elev_m: 10.0,
      min_year: -5500,
      max_year: 2024,
      modern_anchor_year: 2025,
      preserve_hills: true,
    },
    {
      id: "bd_ganges_brahmaputra",
      name: "Ganges-Brahmaputra-Meghna Lower Delta Progradation (Goodbred & Kuehl 2000)",
      bbox: { lat_min: 21.1, lat_max: 23.3, lon_min: 87.7, lon_max: 92.1 },
      max_alluvial_elev_m: 10.0,
      min_year: -5500,
      max_year: 2024,
      modern_anchor_year: 2025,
      preserve_hills: true,
    },
    {
      id: "us_mississippi_birdfoot",
      name: "Mississippi Plaquemines-Balize Birdfoot Delta (Post-1000 AD Progradation)",
      bbox: { lat_min: 28.5, lat_max: 29.8, lon_min: -90.5, lon_max: -88.6 },
      max_alluvial_elev_m: 8.0,
      min_year: -5500,
      max_year: 1899,
      modern_anchor_year: 1900,
      preserve_hills: false,
    },
  ],

  //Ice-dammed proglacial lakes flooded on the 30" DEM against an isostatically tilted water plane.
  //Plane elevation = level_ref + gradient*(distance along azimuth from the reference point), in modern metres.
  //Water only fills ice-free cells connected to a seed, so the lake follows the GLAC-1D ice front year by year.
  proglacial_lakes: [
    {
      id: "lake_agassiz_ojibway",
      name: "Glacial Lake Agassiz-Ojibway",
      bbox: { lat_min: 44.5, lat_max: 61.0, lon_min: -106.0, lon_max: -74.0 },
      seeds: [
        { lat: 47.3, lon: -96.8 },
        { lat: 50.4, lon: -96.9 },
        { lat: 52.6, lon: -97.8 },
        { lat: 54.5, lon: -96.0 },
        { lat: 50.5, lon: -84.0 },
        { lat: 49.5, lon: -79.0 },
      ],
      //Reference: Browns Valley (southern outlet sill); strandlines rise towards the NNE
      tilt: { ref_lat: 45.6, ref_lon: -96.55, azimuth_deg: 25.0 },
      //Great Lakes drainage south of the Hudson Bay divide (Height of Land); Agassiz spilled into it via outlets but never stood at Agassiz level inside it
      exclude_ring: [
        [-93.0, 44.5], [-92.9, 46.6], [-92.3, 47.6], [-91.0, 48.0], [-90.0, 48.1], [-89.3, 48.6],
        [-88.8, 49.3], [-88.0, 49.7], [-86.8, 49.8], [-85.5, 49.5], [-84.3, 49.0], [-83.0, 48.4],
        [-81.5, 48.0], [-80.0, 47.8], [-78.5, 47.6], [-77.0, 47.4], [-74.0, 47.0], [-74.0, 44.5],
        [-93.0, 44.5],
      ],
      //Lockhart/Moorhead low -> Emerson (Campbell level) -> Nipigon -> Ojibway -> 8,2 ka drainage
      level_ref_curve_m: [
        [-10000, 240],
        [-9800, 245],
        [-9600, 290],
        [-9400, 299],
        [-8900, 299],
        [-8600, 285],
        [-8200, 270],
        [-7700, 255],
        [-7000, 245],
        [-6300, 240],
      ],
      gradient_curve_m_per_km: [
        [-10000, 0.16],
        [-9400, 0.15],
        [-8900, 0.14],
        [-7700, 0.12],
        [-6300, 0.10],
      ],
      active_min_year: -10000,
      active_max_year: -6300,
      source: "Teller & Leverington (2004); Leverington et al. (2002); Barber et al. (1999)",
    },
  ],

  //3. Official RCE / Vos et al. (2020/2021) Atlas of the Holocene Netherlands WFS layers
  rce_netherlands_vos: {
    wfs_base_url: "https://services.rce.geovoorziening.nl/paleogeografischekaarten/wfs",
    water_classes: ["buitenwater", "binnenwater", "getijdenzone", "wad"],
    //In early/mid-Holocene (<= -2500), open intertidal kwelder flats behind nascent barrier coast belong to the active tidal basin
    early_holocene_water_classes: ["buitenwater", "binnenwater", "getijdenzone", "wad", "kwelder"],
    early_holocene_max_year: -2500,
    //Southern North Sea relative sea-level curve (m, modern datum) driving when Vos land floods between epochs (Hijma & Cohen 2010; Vos et al. 2020)
    transition_rsl_curve_m: [
      [-9000, -36],
      [-8000, -28],
      [-7000, -21],
      [-6500, -16],
      [-6000, -12],
      [-5500, -8.5],
      [-5000, -6.5],
      [-4000, -4.5],
      [-3000, -3],
      [-2000, -1.8],
      [-1000, -1],
      [0, -0.5],
      [1000, -0.2],
      [1850, 0],
    ],
    outside_classes: ["buiten", "buitenland"],
    epochs: [
      { year: -9000, layer: "paleogeografischekaarten:paleogeografie9000vc" },
      { year: -5500, layer: "paleogeografischekaarten:paleogeografie5500vc" },
      { year: -3850, layer: "paleogeografischekaarten:paleogeografie3850vc" },
      { year: -2750, layer: "paleogeografischekaarten:paleogeografie2750vc" },
      { year: -1500, layer: "paleogeografischekaarten:paleogeografie1500vc" },
      { year: -500, layer: "paleogeografischekaarten:paleogeografie500vc" },
      { year: -250, layer: "paleogeografischekaarten:paleogeografie250vc" },
      { year: 100, layer: "paleogeografischekaarten:paleogeografie100nc" },
      { year: 800, layer: "paleogeografischekaarten:paleogeografie800nc" },
      { year: 1250, layer: "paleogeografischekaarten:paleogeografie1250nc" },
      { year: 1500, layer: "paleogeografischekaarten:paleogeografie1500nc" },
      { year: 1850, layer: "paleogeografischekaarten:paleogeografie1850nc" },
      { year: 2000, layer: "paleogeografischekaarten:paleogeografie2000nc" },
    ],
  },

  //4. Artificial lakes formed by dam spillways / non-GDW reservoirs misclassified as natural lakes in HydroLAKES
  extra_artificial_water_excludes: [
    {
      id: "eg_toshka_lakes",
      name: "Toshka Lakes (Formed 1998 from Lake Nasser Spillway)",
      bbox: { lat_min: 22.4, lat_max: 23.75, lon_min: 30.1, lon_max: 31.65 },
      start_year: 1998,
    },
    {
      id: "eg_lake_nasser_residual",
      name: "Lake Nasser Residual HydroLAKES Polygons (Aswan High Dam 1964-1971)",
      bbox: { lat_min: 21.3, lat_max: 24.05, lon_min: 31.2, lon_max: 33.15 },
      start_year: 1964,
    },
    {
      id: "iq_lake_tharthar",
      name: "Lake Tharthar (Formed 1956 via Samarra Barrage Tigris Flood-Diversion Canal)",
      bbox: { lat_min: 33.55, lat_max: 34.48, lon_min: 42.90, lon_max: 43.70 },
      start_year: 1956,
    },
    {
      id: "iq_lake_razzaza",
      name: "Lake Razzaza / Milh (Formed 1955 via Ramadi Barrage Euphrates Flood Diversion)",
      bbox: { lat_min: 32.35, lat_max: 33.15, lon_min: 43.25, lon_max: 44.08 },
      start_year: 1955,
    },
    {
      id: "tm_uz_lake_sarygamysh",
      name: "Lake Sarygamysh (Formed 1961 from Soviet Amu Darya Irrigation Drainage Canals)",
      bbox: { lat_min: 41.45, lat_max: 42.45, lon_min: 56.90, lon_max: 57.98 },
      start_year: 1961,
    },
  ],
}
