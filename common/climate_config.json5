{
  //Climate indicator configuration: CCSM3 TraCE-21ka + WorldClim 2.1 + CRU TS 4.10 (10000 BC - 2025 AD at 5 arc-minutes)
  sources: {
    gdex_filelist_api: "https://gdex.ucar.edu/api/datasets/d651050/filelist/112?page=1&page_size=4000",
    trace21k_base_url: "https://data.gdex.ucar.edu/d651050/",
    trace21k_min_segment: 16,
    trace21k_max_segment: 36,
    trace21k_vars: ["TREFHT", "PRECC", "PRECL", "PHIS"],
    worldclim_tavg_url: "https://geodata.ucdavis.edu/climate/worldclim/2_1/base/wc2.1_5m_tavg.zip",
    worldclim_prec_url: "https://geodata.ucdavis.edu/climate/worldclim/2_1/base/wc2.1_5m_prec.zip",
    worldclim_elev_url: "https://geodata.ucdavis.edu/climate/worldclim/2_1/base/wc2.1_5m_elev.zip",
    cru_tmp_url: "https://crudata.uea.ac.uk/cru/data/hrg/cru_ts_4.10/cruts.2604091129.v4.10/tmp/cru_ts4.10.1901.2025.tmp.dat.nc.gz",
    cru_pre_url: "https://crudata.uea.ac.uk/cru/data/hrg/cru_ts_4.10/cruts.2604091129.v4.10/pre/cru_ts4.10.1901.2025.pre.dat.nc.gz",
  },

  downscaling: {
    lapse_rate_c_per_m: 0.0065,
    precip_floor_mm_month: 1.0,
    precip_ratio_min: 0.05,
    precip_ratio_max: 10.0,
    ccsm3_ref_start: 1960,
    ccsm3_ref_end: 1990,
    worldclim_ref_start: 1970,
    worldclim_ref_end: 2000,
    cru_splice_start: 1900,
    cru_splice_end: 1950,
    antarctica_lat_cutoff: -60.0,
    ancient_window_half_yrs: 25,
    modern_window_half_yrs: 15,
    ancient_cutoff_year: 1700,
  },

  encoding: {
    netcdf_compression_level: 4,
    netcdf_chunk_shape: [1, 216, 432],
    geopng_format: "uint32_be_rgba",
  },

  //1. Köppen-Geiger (Peel et al. 2007; Beck et al. 2018, 2023)
  koeppen_geiger: {
    var_name: "koeppen_geiger",
    nc_filename: "koeppen_geiger.nc",
    geopng_prefix: "koeppen_geiger_",
    classes: [
      { id: 0, code: "Water", name: "Water/Ocean/Lake", rgb: [162, 210, 238] },
      { id: 1, code: "Af", name: "Tropical, rainforest", rgb: [0, 0, 255] },
      { id: 2, code: "Am", name: "Tropical, monsoon", rgb: [0, 120, 255] },
      { id: 3, code: "Aw", name: "Tropical, savannah", rgb: [70, 170, 250] },
      { id: 4, code: "BWh", name: "Arid, desert, hot", rgb: [255, 0, 0] },
      { id: 5, code: "BWk", name: "Arid, desert, cold", rgb: [255, 150, 150] },
      { id: 6, code: "BSh", name: "Arid, steppe, hot", rgb: [245, 165, 0] },
      { id: 7, code: "BSk", name: "Arid, steppe, cold", rgb: [255, 220, 100] },
      { id: 8, code: "Csa", name: "Temperate, dry summer, hot summer", rgb: [255, 255, 0] },
      { id: 9, code: "Csb", name: "Temperate, dry summer, warm summer", rgb: [200, 200, 0] },
      { id: 10, code: "Csc", name: "Temperate, dry summer, cold summer", rgb: [150, 150, 0] },
      { id: 11, code: "Cwa", name: "Temperate, dry winter, hot summer", rgb: [150, 255, 150] },
      { id: 12, code: "Cwb", name: "Temperate, dry winter, warm summer", rgb: [100, 200, 100] },
      { id: 13, code: "Cwc", name: "Temperate, dry winter, cold summer", rgb: [50, 150, 50] },
      { id: 14, code: "Cfa", name: "Temperate, no dry season, hot summer", rgb: [200, 255, 80] },
      { id: 15, code: "Cfb", name: "Temperate, no dry season, warm summer", rgb: [100, 255, 80] },
      { id: 16, code: "Cfc", name: "Temperate, no dry season, cold summer", rgb: [50, 200, 0] },
      { id: 17, code: "Dsa", name: "Cold, dry summer, hot summer", rgb: [255, 0, 255] },
      { id: 18, code: "Dsb", name: "Cold, dry summer, warm summer", rgb: [200, 0, 200] },
      { id: 19, code: "Dsc", name: "Cold, dry summer, cold summer", rgb: [150, 50, 150] },
      { id: 20, code: "Dsd", name: "Cold, dry summer, very cold winter", rgb: [150, 100, 150] },
      { id: 21, code: "Dwa", name: "Cold, dry winter, hot summer", rgb: [170, 175, 255] },
      { id: 22, code: "Dwb", name: "Cold, dry winter, warm summer", rgb: [90, 120, 220] },
      { id: 23, code: "Dwc", name: "Cold, dry winter, cold summer", rgb: [75, 80, 180] },
      { id: 24, code: "Dwd", name: "Cold, dry winter, very cold winter", rgb: [50, 0, 135] },
      { id: 25, code: "Dfa", name: "Cold, no dry season, hot summer", rgb: [0, 255, 255] },
      { id: 26, code: "Dfb", name: "Cold, no dry season, warm summer", rgb: [55, 200, 255] },
      { id: 27, code: "Dfc", name: "Cold, no dry season, cold summer", rgb: [0, 125, 125] },
      { id: 28, code: "Dfd", name: "Cold, no dry season, very cold winter", rgb: [0, 70, 95] },
      { id: 29, code: "ET", name: "Polar, tundra", rgb: [178, 178, 178] },
      { id: 30, code: "EF", name: "Polar, frost", rgb: [102, 102, 102] },
    ],
  },

  //2. Trewartha (Trewartha & Horn 1980; Belda et al. 2014)
  trewartha: {
    var_name: "trewartha",
    nc_filename: "trewartha.nc",
    geopng_prefix: "trewartha_",
    classes: [
      { id: 0, code: "Water", name: "Water/Ocean/Lake", rgb: [162, 210, 238] },
      { id: 1, code: "Ar", name: "Tropical wet", rgb: [0, 0, 255] },
      { id: 2, code: "Am", name: "Tropical monsoon", rgb: [0, 120, 255] },
      { id: 3, code: "Aw", name: "Tropical wet-dry (dry winter)", rgb: [70, 170, 250] },
      { id: 4, code: "As", name: "Tropical wet-dry (dry summer)", rgb: [120, 200, 255] },
      { id: 5, code: "BWh", name: "Subtropical/tropical desert", rgb: [255, 0, 0] },
      { id: 6, code: "BWk", name: "Temperate/boreal desert", rgb: [255, 150, 150] },
      { id: 7, code: "BSh", name: "Subtropical/tropical steppe", rgb: [245, 165, 0] },
      { id: 8, code: "BSk", name: "Temperate/boreal steppe", rgb: [255, 220, 100] },
      { id: 9, code: "Cs", name: "Subtropical dry summer (Mediterranean)", rgb: [255, 255, 0] },
      { id: 10, code: "Cw", name: "Subtropical dry winter", rgb: [150, 255, 150] },
      { id: 11, code: "Cr", name: "Subtropical humid", rgb: [100, 220, 80] },
      { id: 12, code: "Do", name: "Temperate oceanic", rgb: [0, 180, 90] },
      { id: 13, code: "Dc", name: "Temperate continental", rgb: [55, 200, 255] },
      { id: 14, code: "Eo", name: "Boreal oceanic", rgb: [0, 125, 125] },
      { id: 15, code: "Ec", name: "Boreal continental", rgb: [75, 80, 180] },
      { id: 16, code: "Ft", name: "Polar tundra", rgb: [178, 178, 178] },
      { id: 17, code: "Fi", name: "Polar ice cap", rgb: [102, 102, 102] },
    ],
  },

  //3. Holdridge Life Zones (Holdridge 1947, 1967; Leemans 1990 IIASA; Lugo et al. 1999)
  //Note: Centroids (T_bio_c, P_ann_c) follow the canonical log2 equilateral hexagonal lattice
  holdridge_lifezones: {
    var_name: "holdridge_lifezones",
    nc_filename: "holdridge_lifezones.nc",
    geopng_prefix: "holdridge_lifezones_",
    pet_constant: 58.93,
    polar_tbio_threshold_c: 1.5,
    subtropical_frost_tcold_c: 6.0,
    classes: [
      { id: 0, code: "Water", name: "Water/Ocean/Lake", rgb: [162, 210, 238] },
      { id: 1, code: "Polar_Desert", name: "Polar desert", t_c: 0.75, p_c: 62.5, rgb: [230, 235, 240] },
      { id: 2, code: "Subpolar_Dry_Tundra", name: "Subpolar dry tundra", t_c: 2.1213, p_c: 88.39, rgb: [195, 185, 145] },
      { id: 3, code: "Subpolar_Moist_Tundra", name: "Subpolar moist tundra", t_c: 2.1213, p_c: 176.78, rgb: [145, 180, 150] },
      { id: 4, code: "Subpolar_Wet_Tundra", name: "Subpolar wet tundra", t_c: 2.1213, p_c: 353.55, rgb: [95, 155, 130] },
      { id: 5, code: "Subpolar_Rain_Tundra", name: "Subpolar rain tundra", t_c: 2.1213, p_c: 707.11, rgb: [55, 130, 120] },
      { id: 6, code: "Boreal_Desert", name: "Boreal desert", t_c: 4.2426, p_c: 88.39, rgb: [220, 200, 140] },
      { id: 7, code: "Boreal_Dry_Scrub", name: "Boreal dry scrub", t_c: 4.2426, p_c: 176.78, rgb: [185, 180, 110] },
      { id: 8, code: "Boreal_Moist_Forest", name: "Boreal moist forest", t_c: 4.2426, p_c: 353.55, rgb: [75, 135, 85] },
      { id: 9, code: "Boreal_Wet_Forest", name: "Boreal wet forest", t_c: 4.2426, p_c: 707.11, rgb: [45, 115, 80] },
      { id: 10, code: "Boreal_Rain_Forest", name: "Boreal rain forest", t_c: 4.2426, p_c: 1414.21, rgb: [25, 95, 75] },
      { id: 11, code: "CoolTemp_Desert", name: "Cool temperate desert", t_c: 8.4853, p_c: 88.39, rgb: [235, 200, 120] },
      { id: 12, code: "CoolTemp_Desert_Scrub", name: "Cool temperate desert scrub", t_c: 8.4853, p_c: 176.78, rgb: [215, 185, 100] },
      { id: 13, code: "CoolTemp_Steppe", name: "Cool temperate steppe", t_c: 8.4853, p_c: 353.55, rgb: [185, 200, 95] },
      { id: 14, code: "CoolTemp_Moist_Forest", name: "Cool temperate moist forest", t_c: 8.4853, p_c: 707.11, rgb: [60, 160, 70] },
      { id: 15, code: "CoolTemp_Wet_Forest", name: "Cool temperate wet forest", t_c: 8.4853, p_c: 1414.21, rgb: [30, 135, 65] },
      { id: 16, code: "CoolTemp_Rain_Forest", name: "Cool temperate rain forest", t_c: 8.4853, p_c: 2828.43, rgb: [15, 105, 60] },
      { id: 17, code: "WarmTemp_Desert", name: "Warm temperate desert", t_c: 16.9706, p_c: 88.39, rgb: [245, 175, 95] },
      { id: 18, code: "WarmTemp_Desert_Scrub", name: "Warm temperate desert scrub", t_c: 16.9706, p_c: 176.78, rgb: [230, 170, 85] },
      { id: 19, code: "WarmTemp_Thorn_Steppe", name: "Warm temperate thorn steppe", t_c: 16.9706, p_c: 353.55, rgb: [210, 195, 85] },
      { id: 20, code: "WarmTemp_Dry_Forest", name: "Warm temperate dry forest", t_c: 16.9706, p_c: 707.11, rgb: [140, 195, 75] },
      { id: 21, code: "WarmTemp_Moist_Forest", name: "Warm temperate moist forest", t_c: 16.9706, p_c: 1414.21, rgb: [45, 175, 65] },
      { id: 22, code: "WarmTemp_Wet_Forest", name: "Warm temperate wet forest", t_c: 16.9706, p_c: 2828.43, rgb: [20, 145, 55] },
      { id: 23, code: "WarmTemp_Rain_Forest", name: "Warm temperate rain forest", t_c: 16.9706, p_c: 5656.85, rgb: [10, 115, 50] },
      { id: 24, code: "Subtrop_Desert", name: "Subtropical desert", t_c: 16.9706, p_c: 88.39, rgb: [250, 140, 65] },
      { id: 25, code: "Subtrop_Desert_Scrub", name: "Subtropical desert scrub", t_c: 16.9706, p_c: 176.78, rgb: [240, 155, 65] },
      { id: 26, code: "Subtrop_Thorn_Woodland", name: "Subtropical thorn woodland", t_c: 16.9706, p_c: 353.55, rgb: [220, 185, 70] },
      { id: 27, code: "Subtrop_Dry_Forest", name: "Subtropical dry forest", t_c: 16.9706, p_c: 707.11, rgb: [160, 210, 70] },
      { id: 28, code: "Subtrop_Moist_Forest", name: "Subtropical moist forest", t_c: 16.9706, p_c: 1414.21, rgb: [40, 195, 75] },
      { id: 29, code: "Subtrop_Wet_Forest", name: "Subtropical wet forest", t_c: 16.9706, p_c: 2828.43, rgb: [15, 160, 60] },
      { id: 30, code: "Subtrop_Rain_Forest", name: "Subtropical rain forest", t_c: 16.9706, p_c: 5656.85, rgb: [5, 125, 55] },
      { id: 31, code: "Trop_Desert", name: "Tropical desert", t_c: 26.8, p_c: 88.39, rgb: [255, 80, 40] },
      { id: 32, code: "Trop_Desert_Scrub", name: "Tropical desert scrub", t_c: 26.8, p_c: 176.78, rgb: [245, 120, 50] },
      { id: 33, code: "Trop_Thorn_Woodland", name: "Tropical thorn woodland", t_c: 26.8, p_c: 353.55, rgb: [230, 165, 55] },
      { id: 34, code: "Trop_Very_Dry_Forest", name: "Tropical very dry forest", t_c: 26.8, p_c: 707.11, rgb: [195, 205, 60] },
      { id: 35, code: "Trop_Dry_Forest", name: "Tropical dry forest", t_c: 26.8, p_c: 1414.21, rgb: [125, 210, 65] },
      { id: 36, code: "Trop_Moist_Forest", name: "Tropical moist forest", t_c: 26.8, p_c: 2828.43, rgb: [30, 200, 60] },
      { id: 37, code: "Trop_Wet_Forest", name: "Tropical wet forest", t_c: 26.8, p_c: 5656.85, rgb: [10, 165, 50] },
      { id: 38, code: "Trop_Rain_Forest", name: "Tropical rain forest", t_c: 26.8, p_c: 11313.71, rgb: [0, 130, 45] },
    ],
  },
}
