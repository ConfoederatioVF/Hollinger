{
  //Anthromes 12K indicator configuration (Ellis et al. 2020, 2021) coupled with dynamic landarea and Holdridge biomes
  sources: {
    anthromes12k_raw_data_url: "https://dataverse.harvard.edu/api/access/datafile/4570054",
    anthromes12k_flowchart_url: "https://dataverse.harvard.edu/api/access/datafile/8186904",
    anthromes12k_readme_url: "https://dataverse.harvard.edu/api/access/datafile/4570058",
    hyde35_rel_dir: "../landuse_HYDE3.5",
    hyde_meta_rel_dir: "../metadata_HYDE/general_files",
    ghsl_pop_geotiffs_rel_dir: "../population_GHSL/population_rasters/1.geotiffs",
    ghsl_urban_rasters_rel_dir: "../population_GHSL/urban_area_rasters",
    gapminder_pop_csv_rel_path: "../population_Gapminder/pop-gmv6-with-pre-1800-series 2022-10-20.xlsx - Data-pop-for-countries.csv",
  },

  coastal_and_island_fusion: {
    ghsl_pop_scale_factor: 64.0,
    ghsl_epochs: [1975, 1980, 1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025],
    island_min_land_area_km2: 0.25,
    coastal_immediate_px: 1.5,
    coastal_fringe_px: 3.0,
    paleoshelf_max_px: 20.0,
    paleoshelf_decay_px: 8.0,
    island_regions: [
      { name: "Maldives", iso3: "mdv", boxes: [[0.0, 7.5, 72.4, 74.1]], settlement_year: -500 },
      { name: "Seychelles", iso3: "syc", boxes: [[-10.5, -3.5, 46.0, 56.5]], settlement_year: 1770 },
      { name: "Azores", iso3: "prt", boxes: [[36.5, 40.2, -31.6, -24.5]], settlement_year: 1439 },
      { name: "Madeira", iso3: "prt", boxes: [[32.3, 33.3, -17.5, -16.1]], settlement_year: 1419 },
      { name: "Cape_Verde", iso3: "cpv", boxes: [[14.7, 17.3, -25.5, -22.5]], settlement_year: 1462 },
      { name: "Mauritius", iso3: "mus", boxes: [[-20.6, -19.5, 57.1, 63.6]], settlement_year: 1638 },
      { name: "Reunion", iso3: "reu", boxes: [[-21.5, -20.7, 55.1, 56.0]], settlement_year: 1638 },
      { name: "Bermuda", iso3: "bmu", boxes: [[32.1, 32.5, -65.0, -64.5]], settlement_year: 1609 },
      { name: "Marshall_Islands", iso3: "mhl", boxes: [[4.0, 15.0, 160.5, 173.0]], settlement_year: -1500 },
      { name: "Kiribati", iso3: "kir", boxes: [[-5.0, 5.0, 169.0, 180.0], [-11.5, 5.0, -180.0, -150.0]], settlement_year: -1500 },
      { name: "French_Polynesia", iso3: "pyf", boxes: [[-28.0, -7.5, -155.0, -134.0]], settlement_year: 500 },
      { name: "Fiji", iso3: "fji", boxes: [[-21.0, -12.0, 176.5, 180.0], [-21.0, -15.5, -180.0, -178.0]], settlement_year: -1000 },
      { name: "Tonga", iso3: "ton", boxes: [[-22.5, -15.0, -176.5, -173.0]], settlement_year: -1000 },
      { name: "Samoa", iso3: "wsm", boxes: [[-14.6, -13.3, -173.0, -169.0]], settlement_year: -1000 },
      { name: "Tuvalu", iso3: "tuv", boxes: [[-11.0, -5.0, 176.0, 180.0]], settlement_year: 500 },
      { name: "Micronesia", iso3: "fsm", boxes: [[1.0, 10.5, 137.0, 163.5]], settlement_year: -1500 },
      { name: "Palau", iso3: "plw", boxes: [[2.5, 8.5, 131.0, 135.0]], settlement_year: -1500 },
      { name: "Nauru", iso3: "nru", boxes: [[-1.0, 0.0, 166.5, 167.3]], settlement_year: -1500 },
      { name: "Cook_Islands", iso3: "cok", boxes: [[-22.5, -8.5, -166.5, -157.0]], settlement_year: 500 },
      { name: "Pitcairn", iso3: "pcn", boxes: [[-25.5, -24.0, -131.0, -124.5]], settlement_year: 1790 },
      { name: "Galapagos", iso3: "ecu", boxes: [[-1.8, 1.8, -92.2, -89.0]], settlement_year: 1832 },
      { name: "Falkland_Islands", iso3: "flk", boxes: [[-53.0, -50.8, -61.8, -57.4]], settlement_year: 1764 },
    ],
  },

  classification: {
    //Ellis et al. (2020, 2021) thresholds
    urban_frac_min: 0.2,
    urban_popd_min: 2500.0,
    dense_popd_min: 100.0,
    residential_popd_min: 10.0,
    populated_popd_min: 1.0,
    used_frac_min: 0.2,
    rice_frac_min: 0.2,
    irrigation_frac_min: 0.2,
    crops_frac_min: 0.2,
    grazing_frac_min: 0.2,
    //potveg15.tif woodland/forest classes (1..8) and ice/barren class (15)
    potveg15_tree_ids: [1, 2, 3, 4, 5, 6, 7, 8],
    potveg15_ice_id: 15,
    //Holdridge Life Zones woodland/forest classes (8-10, 14-16, 20-23, 28-30, 35-38; excludes 27/34 dry savanna) and polar/ice (1)
    holdridge_tree_ids: [8, 9, 10, 14, 15, 16, 20, 21, 22, 23, 28, 29, 30, 35, 36, 37, 38],
    holdridge_ice_id: 1,
    biome_anchor_year: 1985,
  },

  encoding: {
    var_name: "anthromes",
    nc_filename: "anthromes.nc",
    geopng_prefix: "anthromes_",
    geopng_format: "uint32_be_rgba",
    netcdf_compression_level: 4,
    netcdf_chunk_shape: [1, 216, 432],
  },

  //Canonical Anthromes 12K integer classification scheme (0 = Water/Ocean/Lake; 11..63 = Terrestrial Anthromes)
  classes: [
    { id: 0, code: "Water", name: "Water/Ocean/Lake", level: "Water", type: "Water", rgb: [162, 210, 238] },
    { id: 11, code: "Urban", name: "Urban", level: "Dense settlements", type: "Intensive", rgb: [168, 0, 0] },
    { id: 12, code: "Mixed_settlements", name: "Mixed settlements", level: "Dense settlements", type: "Intensive", rgb: [255, 0, 0] },
    { id: 21, code: "Rice_villages", name: "Rice villages", level: "Villages", type: "Intensive", rgb: [0, 112, 255] },
    { id: 22, code: "Irrigated_villages", name: "Irrigated villages", level: "Villages", type: "Intensive", rgb: [0, 169, 230] },
    { id: 23, code: "Rainfed_villages", name: "Rainfed villages", level: "Villages", type: "Intensive", rgb: [169, 0, 230] },
    { id: 24, code: "Pastoral_villages", name: "Pastoral villages", level: "Villages", type: "Intensive", rgb: [255, 115, 223] },
    { id: 31, code: "Residential_irrigated_croplands", name: "Residential irrigated croplands", level: "Croplands", type: "Intensive", rgb: [0, 255, 197] },
    { id: 32, code: "Residential_rainfed_croplands", name: "Residential rainfed croplands", level: "Croplands", type: "Intensive", rgb: [230, 230, 0] },
    { id: 33, code: "Populated_croplands", name: "Populated croplands", level: "Croplands", type: "Intensive", rgb: [255, 255, 115] },
    { id: 34, code: "Remote_croplands", name: "Remote croplands", level: "Croplands", type: "Intensive", rgb: [255, 255, 190] },
    { id: 41, code: "Residential_rangelands", name: "Residential rangelands", level: "Rangelands", type: "Intensive", rgb: [230, 152, 0] },
    { id: 42, code: "Populated_rangelands", name: "Populated rangelands", level: "Rangelands", type: "Intensive", rgb: [255, 211, 127] },
    { id: 43, code: "Remote_rangelands", name: "Remote rangelands", level: "Rangelands", type: "Intensive", rgb: [255, 235, 175] },
    { id: 51, code: "Residential_woodlands", name: "Residential woodlands", level: "Cultured", type: "Cultured", rgb: [56, 168, 0] },
    { id: 52, code: "Populated_woodlands", name: "Populated woodlands", level: "Cultured", type: "Cultured", rgb: [165, 245, 122] },
    { id: 53, code: "Remote_woodlands", name: "Remote woodlands", level: "Cultured", type: "Cultured", rgb: [211, 255, 178] },
    { id: 54, code: "Inhabited_drylands", name: "Inhabited drylands", level: "Cultured", type: "Cultured", rgb: [217, 189, 117] },
    { id: 61, code: "Wild_woodlands", name: "Wild woodlands", level: "Wildlands", type: "Wild", rgb: [218, 242, 234] },
    { id: 62, code: "Wild_drylands", name: "Wild drylands", level: "Wildlands", type: "Wild", rgb: [225, 225, 225] },
    { id: 63, code: "Ice", name: "Ice", level: "Wildlands", type: "Wild", rgb: [250, 255, 255] },
  ],
}
