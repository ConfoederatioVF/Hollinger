  //2. Holocene prograding alluvial deltas driven by 30" ocean-connected sediment back-stripping (active >= -5500, zero ghost fade)
  delta_progradation_basins: [
    {
      id: "mesopotamia_persian_gulf",
      name: "Ancient Mesopotamia / Tigris-Euphrates-Karun Delta & Persian Gulf Head",
      bbox: { lat_min: 29.2, lat_max: 32.8, lon_min: 45.0, lon_max: 50.0 },
      sea_seed: { lat: 29.55, lon: 49.1 },
      min_year: -6200,
      clean_stipples: true,
      source: "Lambeck (1996); Heyvaert & Baeteman (2007); Pournelle (2003)",
      //Continuous post-glacial marine incursion (-6200 -> -4500 BC to Ur/Eridu/Lagash ~31.6-31.8N),
      //then calibrated Bronze/Iron/Parthian delta progradation so open sea leaves Basra/Abadan well before 600-1000 AD!
      backstrip_curve_m: [
        [-6200, 0.0],
        [-5500, 2.5],
        [-4500, 6.0],
        [-3800, 5.2],
        [-3000, 3.8],
        [-2200, 2.5],
        [-1500, 1.85],
        [-1000, 1.50],
        [-500, 1.25],
        [-200, 1.10],
        [0, 0.95],
        [300, 0.70],
        [600, 0.48],
        [1000, 0.30],
        [1500, 0.15],
        [1900, 0.05],
        [2025, 0.0],
      ],
    },
    {
      id: "nile_delta",
      name: "Nile Delta Holocene Progradation",
      bbox: { lat_min: 30.4, lat_max: 31.8, lon_min: 29.5, lon_max: 32.8 },
      sea_seed: { lat: 31.65, lon: 31.2 },
      min_year: -5500,
      clean_stipples: true,
      source: "Stanley & Warne (1994)",
      backstrip_curve_m: [
        [-5500, 2.0],
        [-4500, 2.8],
        [-2000, 1.8],
        [0, 1.0],
        [1500, 0.4],
        [1950, 0.1],
        [2025, 0.0],
      ],
    },
    {
      id: "po_delta_venice",
      name: "Po River Delta & Venetian Lagoon Holocene Progradation",
      bbox: { lat_min: 44.1, lat_max: 46.0, lon_min: 11.4, lon_max: 13.8 },
      sea_seed: { lat: 45.0, lon: 13.0 },
      min_year: -5500,
      clean_stipples: true,
      source: "Amorosi et al. (2017)",
      backstrip_curve_m: [
        [-5500, 2.2],
        [-4500, 3.2],
        [0, 1.8],
        [1500, 0.8],
        [1900, 0.25],
        [2025, 0.0],
