  //Ice-dammed proglacial lakes flooded on the 30" DEM against an isostatically tilted water plane.
  //Plane elevation = level_ref + gradient*(distance along azimuth from the reference point), in modern metres.
  //Water only fills ice-free cells connected to a seed, so the lake follows the GLAC-1D ice front year by year.
  proglacial_lakes: [
    {
      id: "lake_agassiz_ojibway",
      name: "Glacial Lake Agassiz-Ojibway",
      bbox: { lat_min: 44.5, lat_max: 61.0, lon_min: -106.0, lon_max: -74.0 },
      seeds: [
        { lat: 47.3, lon: -96.8 },
        { lat: 50.4, lon: -96.9 },
        { lat: 52.6, lon: -97.8 },
        { lat: 54.5, lon: -96.0 },
        { lat: 50.5, lon: -84.0 },
        { lat: 49.4, lon: -82.4 },
        { lat: 49.0, lon: -81.0 },
        { lat: 48.5, lon: -80.8 },
        { lat: 48.7, lon: -79.7 },
        { lat: 49.5, lon: -79.0 },
        { lat: 48.3, lon: -78.8 },
        { lat: 48.6, lon: -78.1 },
      ],
      //Reference: Browns Valley (southern outlet sill); strandlines rise towards Hudson Bay / James Bay rebound centre (12 deg NNE)
      tilt: { ref_lat: 45.6, ref_lon: -96.55, azimuth_deg: 12.0 },
      //Topographic Height of Land divide derived by Priority-Flood on the 2.5' DEM: separates Hudson Bay/Ojibway drainage from Great Lakes/St. Lawrence without straight-line polygon cuts
      watershed_exclude: {
        downsample_factor: 5,
        north_seed_lat_min: 50.8,
        north_seed_max_elev_m: 40.0,
        south_seed_lat_max: 48.6,
        south_seed_lon_min: -92.2,
        south_seed_max_elev_m: 185.0,
      },
      //Lockhart/Moorhead low -> Emerson (Campbell level) -> Nipigon -> Ojibway -> 8,2 ka drainage
      level_ref_curve_m: [
        [-10000, 240],
        [-9800, 245],
        [-9600, 290],
        [-9400, 299],
        [-8900, 299],
        [-8600, 285],
        [-8200, 270],
        [-7700, 255],
        [-7000, 245],
        [-6300, 240],
      ],
      gradient_curve_m_per_km: [
        [-10000, 0.16],
        [-9400, 0.15],
        [-8900, 0.14],
        [-7700, 0.12],
        [-6300, 0.10],
      ],
      active_min_year: -10000,
      active_max_year: -6300,
      source: "Teller & Leverington (2004); Leverington et al. (2002); Barber et al. (1999)",
    },
  ],

  //3. Official RCE / Vos et al. (2020/2021) Atlas of the Holocene Netherlands WFS layers
  rce_netherlands_vos: {
    wfs_base_url: "https://services.rce.geovoorziening.nl/paleogeografischekaarten/wfs",
    water_classes: ["buitenwater", "binnenwater", "getijdenzone", "wad"],
    //In early/mid-Holocene (<= -2500), open intertidal kwelder flats behind nascent barrier coast belong to the active tidal basin
    early_holocene_water_classes: ["buitenwater", "binnenwater", "getijdenzone", "wad", "kwelder"],
    early_holocene_max_year: -2500,
    //Southern North Sea relative sea-level curve (m, modern datum) driving when Vos land floods between epochs (Hijma & Cohen 2010; Vos et al. 2020)
    transition_rsl_curve_m: [
      [-9000, -36],
      [-8000, -28],
      [-7000, -21],
      [-6500, -16],
      [-6000, -12],
      [-5500, -8.5],
      [-5000, -6.5],
      [-4000, -4.5],
      [-3000, -3],
      [-2000, -1.8],
      [-1000, -1],
      [0, -0.5],
      [1000, -0.2],
      [1850, 0],
    ],
    outside_classes: ["buiten", "buitenland"],
    epochs: [
      { year: -9000, layer: "paleogeografischekaarten:paleogeografie9000vc" },
      { year: -5500, layer: "paleogeografischekaarten:paleogeografie5500vc" },
      { year: -3850, layer: "paleogeografischekaarten:paleogeografie3850vc" },
      { year: -2750, layer: "paleogeografischekaarten:paleogeografie2750vc" },
      { year: -1500, layer: "paleogeografischekaarten:paleogeografie1500vc" },
      { year: -500, layer: "paleogeografischekaarten:paleogeografie500vc" },
      { year: -250, layer: "paleogeografischekaarten:paleogeografie250vc" },
      { year: 100, layer: "paleogeografischekaarten:paleogeografie100nc" },
      { year: 800, layer: "paleogeografischekaarten:paleogeografie800nc" },
      { year: 1250, layer: "paleogeografischekaarten:paleogeografie1250nc" },
      { year: 1500, layer: "paleogeografischekaarten:paleogeografie1500nc" },
      { year: 1850, layer: "paleogeografischekaarten:paleogeografie1850nc" },
      { year: 2000, layer: "paleogeografischekaarten:paleogeografie2000nc" },
    ],
  },

  //4. Artificial lakes formed by dam spillways / non-GDW reservoirs misclassified as natural lakes in HydroLAKES
  extra_artificial_water_excludes: [
