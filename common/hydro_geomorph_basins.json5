  //2b. Smooth 30" SDF-migrating paleoshoreline deltas (China Bohai/Jiangsu/Yangtze/PRD matching Herrmann 1 AD,
  //    plus Great Rann of Kutch, Chao Phraya/Bangkok Sea, Mekong, Ganges-Brahmaputra, Mississippi Birdfoot).
  //    ZERO Swiss-cheese interior depression flooding, ZERO ghost alpha-fade, bedrock hills preserved via 30" DEM!
  sdf_delta_progradation_basins: [
    {
      id: "china_bohai_yellow_river",
      name: "Bohai Bay, Tianjin & Yellow River Delta (Herrmann 1 AD / Tan Qixiang)",
