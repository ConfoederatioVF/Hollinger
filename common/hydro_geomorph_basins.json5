{
  //Authoritative 30-arcsecond ETOPO 2022 topographic-contour basin & Holocene delta progradation config.
  //Eliminates hand-drawn blob polygons in favour of real 900m bathymetric/topographic shorelines.

  //1. Closed / sill-controlled basins driven by exact 30" connected-component water-surface elevation z(t) (metres)
  seeded_basins: [
    {
      id: "caspian_sea",
      name: "Caspian Sea & Lower Volga (Late Khvalynian -> Mangyshlak -> New Caspian -> Modern)",
      bbox: { lat_min: 36.0, lat_max: 49.5, lon_min: 45.5, lon_max: 56.0 },
      seed: { lat: 40.0, lon: 51.0 },
      clean_stipples: true,
      //Exclude static HydroLAKES Caspian polygon so dynamic 30" contours control all 218 timesteps
      exclude_from_static_natlakes: true,
      //Published Caspian Sea level curve in m a.s.l. (Krijgsman et al. 2019; Kuzucuoglu & Leroy 2023; Svitoch 2012)
      level_curve_m: [
        [-10000, -18.0],
        [-9500, -28.0],
        [-8800, -50.0],
        [-7500, -48.0],
        [-6500, -26.0],
        [-5500, -19.0],
        [-4000, -19.5],
        [-3000, -22.5],
        [-2000, -25.0],
        [-1000, -26.0],
        [0, -27.5],
        [500, -28.0],
        [1000, -26.5],
        [1500, -25.5],
        [1850, -26.0],
        [1930, -26.2],
        [1977, -29.0],
        [1995, -26.6],
        [2025, -28.5],
      ],
    },
    {
      id: "black_sea_neoeuxinian",
