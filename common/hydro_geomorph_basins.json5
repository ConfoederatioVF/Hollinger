  //5. Dynamic sill-controlled coastal lagoons sourced from HydroLAKES polygon (e.g. Garabogazköl)
  lagoon_basins: [
    {
      id: "garabogazkol_lagoon",
      name: "Garabogazköl (Kara-Bogaz-Gol) Caspian Lagoon & 1980-1992 Soviet Dam",
      bbox: { lat_min: 40.60, lat_max: 42.10, lon_min: 52.75, lon_max: 54.80 },
      level_curve: [
        [-10000, 1.0],
        [-9400, 0.95],
        [-9000, 0.0],
        [-7200, 0.0],
        [-6400, 1.0],
        [1970, 1.0],
        [1977, 0.88],
        [1979, 0.96],
        [1980, 0.80],
        [1981, 0.45],
        [1982, 0.18],
        [1983, 0.03],
        [1991, 0.03],
        [1992, 0.15],
        [1993, 0.65],
        [1994, 0.92],
        [1995, 1.0],
        [2025, 1.0],
      ],
      source: "Kosarev et al. (2009); Dumont (1998); Micklin (2007); Krijgsman et al. (2019)",
    },
  ],

  //6. Arctic Siberian surface hydrology simulation (ArcticHydrologyModel) on the 1' ETOPO 2022 surface per relative sea-level tier:
  //   Priority-Flood D8 drainage, hydraulic-geometry channels, HAND floodplain inundation at the Manning overbank stage, and fill-and-spill depression lakes with a steady-state water balance.
  arctic_hydrology: {
    watershed_bbox: { lat_min: 44.0, lat_max: 80.5, lon_min: 50.0, lon_max: 180.0 },
    bbox: { lat_min: 48.0, lat_max: 79.0, lon_min: 56.0, lon_max: 179.5 },
    edge_fade_deg: 2.5,
    rsl_levels_m: [-80, -72, -64, -56, -48, -40, -32, -24, -16, -8, 0],
    //Channels: downstream hydraulic geometry width_m = width_coeff*Q^width_exp (Moody & Troutman 2002), Q from upstream area x runoff
    channel_min_acc_km2: 1500,
    runoff_m_per_yr: 0.15,
    width_coeff: 7.2,
    width_exp: 0.5,
    //Floodplain: HAND (Nobre et al. 2011) below the overbank stage depth*((flood_factor)^0.6 - 1) from Manning's equation,
    //confined to contiguous overbank wetlands in the polar/coastal lowland belt (smooth latitude & elevation transition)
    manning_n: 0.035,
    flood_factor: 2.5,
    flood_stage_max_m: 12.0,
    slope_reaches: 15,
    min_slope: 0.00001,
    floodplain_lat_south_deg: 62.5,
    floodplain_lat_north_deg: 66.5,
    floodplain_elev_full_m: 35.0,
    floodplain_elev_zero_m: 75.0,
    //Depression lakes: fill-and-spill when catchment runoff >= net lake evaporation x lake area,
    //graded from cold Arctic coastal lowlands toward warmer continental interiors (avoids upland DEM canyon damming)
    lake_net_evaporation_m_per_yr: 0.12,
    lake_net_evaporation_inland_m_per_yr: 1.20,
    lake_lat_south_deg: 62.5,
    lake_lat_north_deg: 66.5,
    lake_elev_full_m: 45.0,
    lake_elev_zero_m: 95.0,
    lake_min_depth_m: 1.0,
    lake_min_area_km2: 6.0,
    //Palaeo-hydrology weight: late-glacial/early-Holocene Ob and Arctic lowlands were wetter than today (wider rivers, flooded valley floors, more lakes); 0 = modern mapped water only (OSM + HydroLAKES)
    palaeo_wetness_curve: [
      [-10000, 1.0],
      [-6000, 1.0],
      [-3000, 0.5],
      [0, 0.0],
    ],
    sectors: [
      { id: "kara", sample_lat: 74.0, sample_lon: 73.0 },
      { id: "laptev", sample_lat: 74.0, sample_lon: 130.0 },
      { id: "eastsib", sample_lat: 73.0, sample_lon: 160.0 },
    ],
    source: "Barnes et al. (2014); Moody & Troutman (2002); Nobre et al. (2011); Grant et al. (2012)",
  },

  //6b. Holocene estuarine/deltaic sediment back-stripping (Step C). Palaeo-surface = bed - max_thickness_m*fz*(1 - completion(t)).
  //    persistent_water: the modern water body of the domain (connected to the seed) stays water in every year as the palaeo river/lake (the lower Ob was wider than today while Yamal extended further north).
  //    Thicknesses are calibration parameters tuned so the Ob/Yenisei estuaries flood c. 7000-6500 BC and deltas prograde through the mid/late Holocene.
  holocene_infill: {
    z_floor_m: -30.0,
    z_full_low_m: -18.0,
    z_full_high_m: 2.0,
    z_top_m: 8.0,
    edge_fade_km: 25.0,
    completion_curve: [
      [-9000, 0.0],
      [-7000, 0.10],
      [-5000, 0.45],
      [-3000, 0.75],
      [-1000, 0.93],
      [1000, 1.0],
    ],
    domains: [
      { id: "ob_gulf", bbox: { lat_min: 66.2, lat_max: 72.7, lon_min: 70.3, lon_max: 75.8 }, seed: { lat: 68.5, lon: 73.5 }, max_thickness_m: 20.0, persistent_water: true },
      { id: "taz_bay", bbox: { lat_min: 66.4, lat_max: 69.6, lon_min: 74.5, lon_max: 79.8 }, seed: { lat: 68.3, lon: 76.8 }, max_thickness_m: 15.0, persistent_water: true },
      { id: "yenisei_gulf", bbox: { lat_min: 69.4, lat_max: 72.6, lon_min: 79.8, lon_max: 84.8 }, seed: { lat: 71.0, lon: 83.0 }, max_thickness_m: 20.0, persistent_water: true },
      { id: "khatanga_gulf", bbox: { lat_min: 71.8, lat_max: 74.4, lon_min: 102.0, lon_max: 112.5 }, seed: { lat: 73.3, lon: 108.0 }, max_thickness_m: 12.0 },
      { id: "lena_delta", bbox: { lat_min: 71.6, lat_max: 74.0, lon_min: 122.3, lon_max: 131.5 }, seed: { lat: 72.5, lon: 127.0 }, max_thickness_m: 18.0 },
      { id: "yana_delta", bbox: { lat_min: 70.3, lat_max: 72.6, lon_min: 133.0, lon_max: 139.0 }, seed: { lat: 71.4, lon: 136.3 }, max_thickness_m: 10.0 },
      { id: "indigirka_delta", bbox: { lat_min: 70.2, lat_max: 72.3, lon_min: 147.0, lon_max: 153.0 }, seed: { lat: 71.3, lon: 150.5 }, max_thickness_m: 10.0 },
      { id: "kolyma_delta", bbox: { lat_min: 68.4, lat_max: 70.5, lon_min: 158.0, lon_max: 163.0 }, seed: { lat: 69.5, lon: 161.3 }, max_thickness_m: 10.0 },
    ],
    source: "Stein et al. (2004); Schwamborn et al. (2002); Bauch et al. (2001)",
  },

  //7. Historic narrow land bridges and explicit island chains below 5' coastline threshold (e.g. Adam's Bridge)
  land_bridges: [
    {
      id: "in_lk_adams_bridge",
      name: "Adam's Bridge / Rama Setu (Pamban-Mannar Limestone Reef Causeway, Breached 1480 AD)",
      breach_start_year: 1480,
      breach_end_year: 1485,
      //Each node: [lat, lon, min_frac_pre_breach, min_frac_post_breach]
      cells: [
        [9.29, 79.13, 0.82, 0.75],
        [9.29, 79.21, 0.82, 0.75],
        [9.29, 79.29, 0.85, 0.78],
        [9.21, 79.38, 0.78, 0.66],
        [9.18, 79.46, 0.75, 0.00],
        [9.13, 79.54, 0.76, 0.64],
        [9.10, 79.63, 0.75, 0.00],
        [9.07, 79.71, 0.78, 0.66],
        [9.04, 79.79, 0.82, 0.72],
        [9.04, 79.88, 0.85, 0.78],
        [8.96, 79.96, 0.85, 0.78],
      ],
      source: "Bahuguna et al. (2003); Dandabathula et al. (2024)",
    },
  ],
}
