{
  "name": "landuse_hollinger",
  "version": "1.1.0",
  "description": "Dynamic 10000 BC to 2025 AD WGS84 4320x2160 land-area, palaeoclimate, and anthrome indicator pipelines (NetCDF-4, GeoPNG, 4K Equal Earth QBAM MP4).",
  "private": true,
  "scripts": {
    "acquire": "node --max-old-space-size=16384 landarea/pipeline/A_acquire_sources.js",
    "anchor": "node --max-old-space-size=16384 landarea/pipeline/B_build_modern_anchor.js",
    "paleo": "node --max-old-space-size=16384 landarea/pipeline/C_build_paleo_gia_ice.js",
    "overlays": "node --max-old-space-size=16384 landarea/pipeline/D_build_dynamic_overlays.js",
    "assemble": "node --max-old-space-size=16384 landarea/pipeline/E_assemble_outputs.js",
    "audit": "node --max-old-space-size=16384 landarea/pipeline/F_audit_optical_qa.js",
    "render": "node --max-old-space-size=16384 landarea/pipeline/G_render_animation.js",
    "pipeline": "node --max-old-space-size=16384 landarea/pipeline/run_pipeline.js",
    "climate:pipeline": "python climate/pipeline/run_pipeline.py",
    "anthromes:pipeline": "python anthromes/pipeline/run_pipeline.py",
    "render:climate": "node --max-old-space-size=16384 climate/pipeline/D_render_animations.js",
    "render:anthromes": "node --max-old-space-size=16384 anthromes/pipeline/D_render_animation.js",
    "render:all": "node --max-old-space-size=16384 core/CategoricalAnimationRenderer.js --target=all",
    "compress:all": "node core/compress_exports.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "h5wasm": "^0.8.8",
    "shapefile": "^0.6.6"
  }
}
